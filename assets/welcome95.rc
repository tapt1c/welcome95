#include <windows.h>
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
1 ICON "welcome95.ico"
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904E4"
  BEGIN
   VALUE "FileDescription", "Welcome95\0"
   VALUE "FileVersion", "1.0.0.0\0"
   VALUE "InternalName", "Welcome95\0"
   VALUE "OriginalFilename", "WELCOME95.EXE\0"
   VALUE "ProductName", "Welcome95\0"
   VALUE "ProductVersion", "1.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1252
 END
END

100 BITMAP "glow.bmp"
103 BITMAP "arrow.bmp"
107 BITMAP "power.bmp"
112 BITMAP "tile.bmp"
114 BITMAP "avatar.bmp"
